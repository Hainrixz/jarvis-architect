{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "jarvis-architect",
  "permissions": {
    "allow": [
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(python3 --version)",
      "Bash(uv --version)",
      "Bash(bun --version)",
      "Bash(git --version)",
      "Bash(brew --version)",
      "Bash(docker --version)",
      "Bash(apt --version)",
      "Bash(dnf --version)",
      "Bash(claude --version)",
      "Bash(claude auth status *)",
      "Bash(claude auth status)",
      "Bash(ollama --version)",
      "Bash(ollama list)",
      "Bash(hermes --version)",
      "Bash(openclaw --version)",
      "Bash(codex --version)",
      "Bash(railway --version)",
      "Bash(railway whoami *)",
      "Bash(railway whoami)",
      "Bash(uname *)",
      "Bash(sw_vers)",
      "Bash(sw_vers *)",
      "Bash(sysctl -n hw.memsize)",
      "Bash(free *)",
      "Bash(df -h *)",
      "Bash(cat /etc/os-release)",
      "Bash(grep -i microsoft /proc/version)",
      "Bash(nvidia-smi --query-gpu *)",
      "Bash(shasum -a 256 *)",
      "Bash(sha256sum *)",
      "Bash(gpg --verify *)",
      "PowerShell(Get-CimInstance *)",
      "PowerShell(Get-FileHash *)",
      "PowerShell(Get-PSDrive *)",
      "PowerShell(wsl -l -v)",
      "PowerShell(wsl --status)",
      "PowerShell(winget --version)",
      "Bash([ -n \"$ANTHROPIC_API_KEY\" ] && echo set)",
      "Bash([ -n \"$OPENAI_API_KEY\" ] && echo set)",
      "Bash([ -n \"$OPENROUTER_API_KEY\" ] && echo set)",
      "Bash(docker info --format *)",
      "Bash(nvidia-ctk --version)",
      "Bash(zstd --version)",
      "Bash(loginctl show-user * -p Linger)",
      "PowerShell($env:PROCESSOR_ARCHITECTURE)",
      "PowerShell((Get-CimInstance Win32_ComputerSystem).TotalPhysicalMemory)",
      "PowerShell(if ($env:ANTHROPIC_API_KEY) { 'set' })",
      "PowerShell(if ($env:OPENAI_API_KEY) { 'set' })",
      "PowerShell(if ($env:OPENROUTER_API_KEY) { 'set' })",
      "PowerShell(scoop --version)",
      "PowerShell(nvidia-smi --query-gpu *)",
      "PowerShell(node --version)",
      "PowerShell(npm --version)",
      "PowerShell(python --version)",
      "PowerShell(uv --version)",
      "PowerShell(bun --version)",
      "PowerShell(git --version)",
      "PowerShell(docker --version)",
      "PowerShell(claude --version)",
      "PowerShell(claude auth status)",
      "PowerShell(hermes --version)",
      "PowerShell(openclaw --version)",
      "PowerShell(codex --version)",
      "PowerShell(ollama --version)",
      "PowerShell(ollama list)",
      "PowerShell(railway --version)",
      "PowerShell(railway whoami)"
    ],
    "ask": [
      "Bash(brew install *)",
      "Bash(npm install -g *)",
      "Bash(npm i -g *)",
      "Bash(uv tool install *)",
      "Bash(pip install *)",
      "Bash(docker run *)",
      "Bash(docker compose *)",
      "PowerShell(winget install *)",
      "Bash(railway up *)",
      "Bash(railway up)",
      "Bash(railway variables *)",
      "Bash(railway variable *)",
      "Bash(railway config apply *)",
      "Bash(railway config plan*)",
      "Bash(railway link*)",
      "Bash(railway usage *)",
      "Bash(railway add *)",
      "Bash(railway volume *)",
      "Bash(railway domain *)",
      "Bash(launchctl *)",
      "Bash(systemctl *)",
      "Bash(pm2 *)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "PowerShell(iex *)",
      "PowerShell(Invoke-Expression *)",
      "Read(./.env)",
      "Read(**/.env)",
      "Read(~/.hermes/.env)",
      "Read(~/.claude/channels/**/.env)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.jobs)"
    ]
  }
}
