# Jarvis Panel — configuración. Copia este archivo a panel/.env y llénalo (chmod 600 .env).
# Nunca subas .env a git ni lo pegues en un chat.

# --- Tu Jarvis ---
# Carpeta de tu Jarvis (donde viven SOUL.md, MEMORY.md, jobs.json…). Relativa a panel/. Default: ..
JARVIS_HOME=..
# Nombre que verás en el panel.
JARVIS_NAME=Jarvis
# Runtime que se muestra en /api/health (claude-code-local, hermes, codex-openai, ollama-local…). Opcional.
JARVIS_RUNTIME=
# Carpeta de memoria si tu runtime la guarda en otro lado. Vacío = JARVIS_HOME.
JARVIS_MEMORY_DIR=

# --- Dónde escucha el panel ---
# 127.0.0.1 = solo esta computadora (recomendado). Si pones 0.0.0.0 el panel NO arranca sin PANEL_PASSWORD.
PANEL_HOST=127.0.0.1
# Puerto. Abre http://127.0.0.1:7878 (si no hay PANEL_PORT se usa PORT, útil en Railway).
PANEL_PORT=7878
# Contraseña del panel (mínimo 12 caracteres). Obligatoria si el panel sale de esta computadora.
PANEL_PASSWORD=
# Nombres extra aceptados en el encabezado Host, separados por coma. OBLIGATORIO si entras con
# `tailscale serve` (pon el nombre de tu compu, ej. mi-mac.tailnet-xyz.ts.net); si no, verás "Host no permitido".
PANEL_ALLOWED_HOSTS=
# Cookie "Secure" (solo HTTPS). auto = activada cuando el panel no está en 127.0.0.1.
PANEL_COOKIE_SECURE=auto
# Horas que dura la sesión después de entrar con la contraseña.
PANEL_SESSION_HOURS=12
# Pon 1 solo detrás de un proxy de confianza (Railway, Tailscale serve) para leer la IP real de X-Forwarded-For
# (el panel usa la última IP de la lista, la que agrega tu proxy).
PANEL_TRUST_PROXY=0
# Tamaño máximo de una petición, en KB.
PANEL_MAX_BODY_KB=512

# --- Con qué cerebro habla el panel ---
# claude-cli | agent-sdk | openai-compatible | codex-cli | mock
#   claude-cli         Claude Code instalado en esta compu, con tu propio login.
#   agent-sdk          Claude Agent SDK en un servidor (necesita ANTHROPIC_API_KEY y `npm install @anthropic-ai/claude-agent-sdk`).
#   openai-compatible  Hermes (API server), Ollama o LM Studio.
#   codex-cli          Codex CLI de OpenAI instalado en esta compu.
#   mock               Demo sin modelo (solo pruebas).
# OpenClaw no usa este panel: trae su propia Control UI (déjala en 127.0.0.1).
PANEL_ADAPTER=

# --- claude-cli / agent-sdk ---
# Ruta del binario de Claude Code.
CLAUDE_BIN=claude
# Ajustes para las corridas del panel (sandbox y sin un segundo lector de Telegram).
# Vacío = usa .claude/headless-settings.json si existe en tu Jarvis.
CLAUDE_SETTINGS_FILE=
# Herramientas que Claude puede usar sin preguntar, separadas por coma (ej. Read,Grep,Edit). Vacío = ninguna extra.
CLAUDE_ALLOWED_TOOLS=
# Modo de permisos: dontAsk (default: niega lo que pediría permiso) | manual | acceptEdits | plan | auto.
# El modo que se salta los permisos está prohibido en el panel.
CLAUDE_PERMISSION_MODE=dontAsk
# Tiempo máximo por respuesta, en milisegundos.
CLAUDE_TIMEOUT_MS=600000
# Modelo para agent-sdk (vacío = el default del SDK).
AGENT_SDK_MODEL=
# agent-sdk lee ANTHROPIC_API_KEY del entorno (pon un tope de gasto en la consola antes).
# ANTHROPIC_API_KEY=

# --- openai-compatible (Hermes / Ollama / LM Studio) ---
# Hermes API server: http://127.0.0.1:8642/v1  (en Hermes: API_SERVER_ENABLED=true, API_SERVER_HOST=127.0.0.1)
# Ollama:            http://127.0.0.1:11434/v1
OPENAI_COMPAT_BASE_URL=
# Hermes: el mismo valor que API_SERVER_KEY. Ollama: vacío.
OPENAI_COMPAT_API_KEY=
# Modelo (Ollama: ej. qwen3:8b). Hermes: vacío usa el suyo.
OPENAI_COMPAT_MODEL=
# 1 = mandar SOUL.md, USER.md y MEMORY.md como mensaje de sistema (útil con Ollama; Hermes ya tiene su memoria).
OPENAI_COMPAT_INJECT_MEMORY=0

# --- codex-cli ---
CODEX_BIN=codex
# read-only (default, más seguro) | workspace-write. El modo de acceso total está prohibido en el panel.
CODEX_SANDBOX=read-only

# --- solo pruebas ---
# Pausa entre palabras del adaptador mock, en ms.
MOCK_DELAY_MS=15
