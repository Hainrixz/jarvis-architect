#!/usr/bin/env bash
# jobs/<job>.post <claude-output.json>: post hook for jobs that change TASKS.md through ops.
# Canonical copy: templates/local/jobs/autopilot.post (contract: knowledge/capabilities/scheduling.md
# § run-job.sh, rules: knowledge/capabilities/autonomy.md). Installed as jobs/autopilot.post and,
# for the end-of-day job, as a byte-identical copy named after that job (e.g. jobs/cierre.post).
#
# run-job.sh calls it after a successful run, before delivery. It:
#   1. takes `.result` from the claude JSON output;
#   2. finds the single fenced block that holds {"ops":[...],"drafts":[...]} (```json, or a bare ```
#      fence whose content starts with "{" and names "ops");
#   3. pipes it to jobs/apply-ops.sh --actor <job> (all or nothing, audited);
#   4. prints the owner-facing text WITHOUT the block and without silent-token lines on stdout
#      (empty = stay silent).
# Exit ≠ 0 (more than one block, or apply-ops rejected the block) makes run-job.sh send the AVISO.
set -euo pipefail
OUT="${1:-}"
if [ -z "$OUT" ] || [ ! -f "$OUT" ]; then echo "post: missing claude output file" >&2; exit 2; fi
HERE="$(cd "$(dirname "$0")" && pwd)"
JOB="$(basename "$0" .post)"
case "$JOB" in (""|-*|*[!a-z0-9-]*) echo "post: bad job name" >&2; exit 2;; esac

TEXT="$(jq -r '.result // empty' "$OUT")"
# Fences sit on their own lines. The ops block is a ```json fence, or a bare ``` fence whose
# content starts with "{" and names "ops" (models sometimes drop the language tag). Other fenced
# text stays in the note. blocks <count|block|text> prints the count, the block, or the rest.
blocks() {
  printf '%s\n' "$TEXT" | awk -v mode="$1" '
    { L[++n] = $0 }
    END {
      inb = 0; nb = 0; bad = 0
      for (i = 1; i <= n; i++) {
        if (!inb && L[i] ~ /^[[:space:]]*```(json)?[[:space:]]*$/) { inb = 1; s = i; js = (L[i] ~ /json/); continue }
        if (inb && L[i] ~ /^[[:space:]]*```[[:space:]]*$/) {
          inb = 0; ops = js
          if (!ops) { first = ""; has = 0
            for (k = s + 1; k < i; k++) { if (first == "" && L[k] ~ /[^[:space:]]/) first = L[k]; if (L[k] ~ /"ops"/) has = 1 }
            ops = (first ~ /^[[:space:]]*\{/ && has) }
          if (ops) { nb++; for (k = s; k <= i; k++) skip[k] = 1; bs = s; be = i }
        }
      }
      if (inb && js) bad = 1
      if (mode == "count") { print (bad ? -1 : nb); exit }
      if (mode == "block") { for (k = bs + 1; k < be; k++) print L[k]; exit }
      for (i = 1; i <= n; i++) if (!skip[i]) print L[i]
    }'
}
NBLOCKS="$(blocks count)"
if [ "$NBLOCKS" -lt 0 ]; then echo "post: unterminated ops block" >&2; exit 3; fi
if [ "$NBLOCKS" -gt 1 ]; then echo "post: more than one ops block; nothing applied" >&2; exit 3; fi

if [ "$NBLOCKS" -eq 1 ]; then
  blocks block | "$HERE/apply-ops.sh" --actor "$JOB" > /dev/null   # stderr → logs/<job>.stderr
  TEXT="$(blocks text)"
fi

# Drop silent-token lines (HEARTBEAT_OK, NADA, [SILENT], NO_REPLY) so a real note followed by the
# token is still delivered; trim blank lines. What remains is the ≤6-line note (empty = silent).
printf '%s\n' "$TEXT" | awk '$0 ~ /^[[:space:]]*(HEARTBEAT_OK|NADA|\[SILENT\]|NO_REPLY)[[:space:]]*$/ { next }
  NF { found = 1 } found { buf[++n] = $0 } END { while (n > 0 && buf[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print buf[i] }'
